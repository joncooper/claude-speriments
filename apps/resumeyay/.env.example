# Resumeyay Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CLAUDE API (Required for LLM features)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# FIREBASE (Required for persistence and auth)
# =============================================================================
# Get these from Firebase Console > Project Settings

# Web app config (for client-side)
FIREBASE_API_KEY=AIza...
FIREBASE_PROJECT_ID=your-project-id

# Service account (for server-side) - from Project Settings > Service Accounts
# You can either set these env vars OR place the JSON file at server/firebase-service-account.json
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
NODE_ENV=development
