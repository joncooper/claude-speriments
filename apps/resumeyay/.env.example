# Resumeyay Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CLAUDE API (Required for LLM features)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# FIREBASE - CLIENT SIDE (Required for auth)
# =============================================================================
# Get these from Firebase Console > Project Settings > Your apps > Web app
# These are prefixed with VITE_ so Vite exposes them to the browser

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# =============================================================================
# FIREBASE - SERVER SIDE (Required for Firestore)
# =============================================================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Click "Generate new private key" to download the JSON file

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative: Place the service account JSON file at:
# server/firebase-service-account.json

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
NODE_ENV=development
